#!/usr/bin/env bash
#
# git-worktree-go: jump to a branch in its own herdr worktree workspace,
# creating the worktree (and, if needed, the branch) on the way.
#
# - branch already has a worktree      -> focus it, or open it if it is closed
# - branch exists locally              -> new worktree off the existing branch
# - branch exists on origin, not local -> new worktree tracking origin/<branch>
# - branch exists nowhere              -> new branch off origin/<default>,
#                                          left unpushed with push.autoSetupRemote
#
# Whenever it opens a workspace (fresh or previously closed), it splits it into
# two stacked panes and runs claude in the top one. For a fresh worktree it also
# installs dependencies (pnpm, yarn, bun or npm,
# picked by lockfile) in a background herdr tab, and warms up VS Code.
#
set -euo pipefail

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Error: not a git repository" >&2
  exit 1
fi

branch="${1:-}"
if [ -z "$branch" ]; then
  echo "Usage: git worktree-go <branch>" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
simplified="${branch#*/}"

worktree_list=$(herdr worktree list --cwd "$repo_root")

workspace_id="${HERDR_WORKSPACE_ID:-}"
if [ -z "$workspace_id" ]; then
  workspace_id=$(printf '%s' "$worktree_list" | jq -r '.result.source.source_workspace_id')
fi
if [ -z "$workspace_id" ] || [ "$workspace_id" = "null" ]; then
  echo "Error: no herdr workspace found for $repo_root, open it in herdr first" >&2
  exit 1
fi

# Two stacked panes in the workspace of the worktree at $1, claude in the top one.
setup_panes() {
  local wt_path="$1" ws top_pane
  ws=$(herdr worktree list --cwd "$repo_root" | jq -r --arg p "$wt_path" '.result.worktrees[] | select(.path == $p) | .open_workspace_id // empty' | head -n1)
  top_pane=$(herdr pane list --workspace "${ws:-$workspace_id}" | jq -r '.result.panes[0].pane_id // empty')
  if [ -n "$top_pane" ]; then
    herdr pane split "$top_pane" --direction down --cwd "$wt_path" --no-focus >/dev/null
    herdr pane run "$top_pane" "claude" >/dev/null
  fi
}

existing=$(printf '%s' "$worktree_list" | jq -r --arg b "$branch" '.result.worktrees[] | select(.branch == $b) | [.path, (.open_workspace_id // "")] | @tsv' | head -n1)

if [ -n "$existing" ]; then
  existing_path=${existing%%$'\t'*}
  existing_ws=${existing#*$'\t'}
  herdr worktree open --workspace "$workspace_id" --path "$existing_path" --focus >/dev/null
  if [ -n "$existing_ws" ]; then
    echo "worktree for '$branch' already open, focusing it"
  else
    echo "worktree for '$branch' exists but was not open, opening it"
    setup_panes "$existing_path"
  fi
  exit 0
fi

if git show-ref --verify --quiet "refs/heads/$branch"; then
  echo "local branch '$branch' exists, checking it out into a new worktree"
  result=$(herdr worktree create --workspace "$workspace_id" --branch "$branch" --label "$simplified" --focus)
else
  git fetch origin --quiet

  if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    echo "remote branch 'origin/$branch' found, tracking it in a new worktree"
    result=$(herdr worktree create --workspace "$workspace_id" --branch "$branch" --base "origin/$branch" --label "$simplified" --focus)
  else
    default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's#^origin/##')
    echo "no local or remote branch '$branch', creating a new branch from origin/$default_branch"
    result=$(herdr worktree create --workspace "$workspace_id" --branch "$branch" --base "origin/$default_branch" --label "$simplified" --focus)

    new_path=$(printf '%s' "$result" | jq -r '.result.worktree.path')
    git -C "$new_path" config push.autoSetupRemote true
  fi
fi

path=$(printf '%s' "$result" | jq -r '.result.worktree.path')

# Fresh worktree: two stacked panes, claude in the top one.
setup_panes "$path"
new_ws=$(herdr worktree list --cwd "$repo_root" | jq -r --arg p "$path" '.result.worktrees[] | select(.path == $p) | .open_workspace_id // empty' | head -n1)

# Fresh worktree: install dependencies.
install_cmd=""
if [ -f "$path/pnpm-lock.yaml" ]; then install_cmd="pnpm install"
elif [ -f "$path/yarn.lock" ]; then install_cmd="yarn install"
elif [ -f "$path/bun.lock" ] || [ -f "$path/bun.lockb" ]; then install_cmd="bun install"
elif [ -f "$path/package-lock.json" ]; then install_cmd="npm install"
fi
if [ -n "$install_cmd" ]; then
  # Run it in a background tab of the new workspace, so progress is visible in
  # herdr. The tab closes on success and stays open on failure.
  tab=$(herdr tab create --workspace "${new_ws:-$workspace_id}" --cwd "$path" --label "install" --no-focus)
  tab_id=$(printf '%s' "$tab" | jq -r '.result.tab.tab_id')
  pane_id=$(printf '%s' "$tab" | jq -r '.result.root_pane.pane_id')
  echo "running '$install_cmd' in background tab $tab_id"
  herdr pane run "$pane_id" "$install_cmd && herdr notification show 'deps installed' --body '$simplified' --sound done && herdr tab close $tab_id || herdr notification show 'install failed' --body '$simplified' --sound request" >/dev/null
fi

# Warm up VS Code without stealing focus (-g) and keep it hidden (-j).
if command -v code >/dev/null 2>&1; then
  open -g -j -a "Visual Studio Code" "$path" >/dev/null 2>&1 || true
fi

printf '%s\n' "$path"
